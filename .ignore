# MSBuild / Visual Studio compiler output: binaries, PDBs, XML docs, and COM interop wrappers under Client/bin, Client/obj, Server/bin, and Server/obj.
bin/
obj/

# Visual Studio upgrade-wizard backup of the pre-conversion project (Client/Backup, Server/Backup).
Backup/

# Visual Studio upgrade-wizard conversion report (UpgradeReport.css, UpgradeReport.xslt, and the plus/minus gif assets).
_UpgradeReport_Files/

# Visual Studio upgrade-wizard conversion log written next to each converted project.
UpgradeLog.XML

# Visual Studio generated designer code. Each file is marked "This code was generated by a tool"
# (StronglyTypedResourceBuilder for Resources.Designer.vb, SettingsSingleFileGenerator for Settings.Designer.vb).
Resources.Designer.vb
Settings.Designer.vb
